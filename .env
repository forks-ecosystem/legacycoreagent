# legacycoreagent configuration
LEGACYCOIN_PORT=8444
LEGACYCOIN_HOST=127.0.0.1
LEGACYCOIN_DATADIR=/home/coin/.legacycoin
LEGACYCOIN_RPC_URL=http://127.0.0.1:19556
LEGACYCOIN_RPC_USER=coin
LEGACYCOIN_RPC_PASS=coin
# Secret for POST /api/chain/{coin}/send (X-Api-Key header). Must match the
# PHP server-side wallet code; never expose to browsers.
LEGACYCOIN_API_KEY=62u6HL6vgNnACj2gm2braH6AE9WqVyLDmTrsJl6h0I=
# Signer service that signs LBTC/BTC withdrawals (127.0.0.1:8053).
LEGACYCOIN_SIGNER_URL=http://127.0.0.1:8053
# Node wallet that holds the LBTC hot float. sendtoaddress/getbalance/sweepallraw
# are wallet-scoped and default to "default" without this, which has no float.
LEGACYCOIN_HOT_WALLET=withdrawal
# Optional audit sink: wallet_db (system_wallets / wallet_requests). Leave empty
# to disable wallet_requests logging.
LEGACYCOIN_WALLET_DB_DSN=postgres://wallet_user:secret123@127.0.0.1:5436/wallet_db?sslmode=disable
