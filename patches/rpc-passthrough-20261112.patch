+func (s *Service) cookieAuth() string {
+	path := filepath.Join(s.dataDir, ".cookie")
+	st, err := os.Stat(path)
+	if err != nil || st.Size() == 0 || st.Size() > 512 {
+		return ""
+	}
+	if s.cookieFile == path && s.cookieModTime.Equal(st.ModTime()) && s.cookieAuthCache != "" {
+		return s.cookieAuthCache
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return ""
+	}
+	auth := strings.TrimSpace(string(raw))
+	if !strings.Contains(auth, ":") {
+		return ""
+	}
+	s.cookieFile = path
+	s.cookieModTime = st.ModTime()
+	s.cookieAuthCache = auth
+	return auth
+}
